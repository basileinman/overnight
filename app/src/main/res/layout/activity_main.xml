<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- top bar: distance readout | NIGHT/DAY -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/focusReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:drawableStart="@drawable/ic_focus"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:letterSpacing="0.06"
                android:text="4ft"
                android:textColor="#FF7A1F"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/modeBtn"
                style="@style/TopLabel"
                android:layout_gravity="end|center_vertical"
                android:text="NIGHT" />
        </FrameLayout>

        <!-- 2:3 viewfinder, height set in code -->
        <FrameLayout
            android:id="@+id/previewFrame"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextureView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <app.flashcam.FrameMarks
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/ghost"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.35"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <app.flashcam.EvRuler
                android:id="@+id/evRuler"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/evBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/ev_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="9dp"
                android:paddingEnd="18dp"
                android:paddingBottom="9dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/evTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:text="NIGHT EXP"
                    android:textColor="#99FFFFFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/evValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 EV"
                    android:textColor="#FF7A1F"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/ev_box"
                android:fontFamily="monospace"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="#FF7A1F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- brief label when a toggle is tapped -->
            <TextView
                android:id="@+id/toggleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="22dp"
                android:background="@drawable/ev_box"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:alpha="0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="TAP ANYWHERE TO SHOOT"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />

            <!-- subtle shutter blink -->
            <View
                android:id="@+id/shutterBlink"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="#FFFFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <!-- small icon toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/burstBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Shot mode"
                android:padding="8dp" />

            <ImageView
                android:id="@+id/blurBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Effect"
                android:padding="8dp" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/status"
                style="@style/SmallOpt"
                android:layout_marginEnd="0dp"
                android:text="" />
        </LinearLayout>

        <!-- bottom: roll | load roll -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="90dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/rounded_btn"
                android:contentDescription="Roll"
                android:padding="1.5dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/flipBtn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/rounded_btn"
                android:contentDescription="Roll"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:lineSpacingMultiplier="0.95"
                android:text="LOAD\nROLL"
                android:textColor="#B3FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
