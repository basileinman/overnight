<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- top bar: focus mode | focus readout | NIGHT/DAY -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <TextView
                android:id="@+id/focusBtn"
                style="@style/TopLabel"
                android:layout_gravity="start|center_vertical"
                android:text="CLOSE ˅" />

            <TextView
                android:id="@+id/focusReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawableTop="@drawable/ic_focus"
                android:drawablePadding="2dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="3ft"
                android:textColor="#FF7A1F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modeBtn"
                style="@style/TopLabel"
                android:layout_gravity="end|center_vertical"
                android:text="NIGHT" />
        </FrameLayout>

        <!-- 2:3 viewfinder, height set in code -->
        <FrameLayout
            android:id="@+id/previewFrame"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextureView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <app.flashcam.EvRuler
                android:id="@+id/evRuler"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/evBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/ev_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/evTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:text="NIGHT EXP"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/evValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 EV"
                    android:textColor="#FF7A1F"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/ev_box"
                android:fontFamily="monospace"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="#FF7A1F"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- small secondary options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="10dp"
            android:paddingEnd="22dp">

            <TextView android:id="@+id/flashBtn" style="@style/SmallOpt" android:text="PULSE" />
            <TextView android:id="@+id/burstBtn" style="@style/SmallOpt" android:text="×1" />
            <TextView android:id="@+id/blurBtn" style="@style/SmallOpt" android:text="BLUR" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/status"
                style="@style/SmallOpt"
                android:layout_marginEnd="0dp"
                android:text="ROLL 00" />
        </LinearLayout>

        <!-- bottom: thumbnail | flip -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="90dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/rounded_btn"
                android:contentDescription="Roll"
                android:padding="1.5dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/flipBtn"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/rounded_btn"
                android:contentDescription="Flip camera"
                android:scaleType="center"
                android:src="@drawable/ic_flip" />
        </FrameLayout>
    </LinearLayout>

    <!-- front-camera screen flash -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
