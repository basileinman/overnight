<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.25"
                android:text="FLASHCAM"
                android:textColor="#FF7A1F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:text="ROLL 00"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3:4 viewfinder, height set in code -->
        <FrameLayout
            android:id="@+id/previewFrame"
            android:layout_width="match_parent"
            android:layout_height="400dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/chip"
                android:fontFamily="monospace"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="#FF7A1F"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:text="TAP ANYWHERE TO SHOOT"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />
        </FrameLayout>

        <!-- mode chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/modeBtn"
                style="@style/Chip"
                android:text="reference" />

            <TextView
                android:id="@+id/focusBtn"
                style="@style/Chip"
                android:text="PORTRAIT" />

            <TextView
                android:id="@+id/burstBtn"
                style="@style/Chip"
                android:text="×1" />

            <TextView
                android:id="@+id/blurBtn"
                style="@style/Chip"
                android:text="BLUR" />

        </LinearLayout>

        <!-- shutter row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="96dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="32dp"
                android:background="#1AFFFFFF"
                android:contentDescription="Last photo"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/shutter"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter"
                android:contentDescription="Shutter" />

            <TextView
                android:id="@+id/flipBtn"
                style="@style/Chip"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="28dp"
                android:text="BACK" />
        </FrameLayout>
    </LinearLayout>

    <!-- front-camera screen flash -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
